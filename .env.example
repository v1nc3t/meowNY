DATABASE_URL=postgres://meowny:meowny@127.0.0.1:5432/meowny
DATABASE_URL_TEST=postgres://meowny:meowny@127.0.0.1:5432/meowny_test
PORT=3000

# Auth secret for Better Auth. Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=change_me
BETTER_AUTH_URL=http://127.0.0.1:3000
FRONTEND_ORIGIN=http://127.0.0.1:5173

# Local Mailpit catches every message. Inbox UI: http://127.0.0.1:8025. Nothing reaches a real inbox.
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
SMTP_FROM=meowny@localhost
# To send real mail, point these at an SMTP provider (port 587 uses STARTTLS, 465 uses TLS).
# SMTP_USER=
# SMTP_PASS=

# Optional. Both must be set, or Google sign-in stays off.
# Dev redirect URI: http://127.0.0.1:3000/api/auth/callback/google
# Production: a separate OAuth client, same path on the API origin.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
