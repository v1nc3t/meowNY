{
  "name": "meowny-server",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "NODE_ENV=development tsx --env-file-if-exists=../.env src/main.ts",
    "start": "node --env-file-if-exists=../.env dist/main.js",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint src test",
    "test": "tsx --env-file-if-exists=../.env --test --test-concurrency=1 test/**/*.test.ts",
    "migrate": "tsx --env-file-if-exists=../.env src/db/migrate.ts",
    "seed": "tsx --env-file-if-exists=../.env src/db/seed.ts",
    "db:types": "kysely-codegen"
  },
  "kysely-codegen": {
    "dialect": "postgres",
    "envFile": "../.env",
    "excludePattern": "pgmigrations",
    "outFile": "src/db/schema.ts",
    "numericParser": "string",
    "dateParser": "string",
    "typeMapping": {
      "numeric": "string"
    }
  },
  "dependencies": {
    "better-auth": "^1.7.7",
    "express": "^5.2.1",
    "kysely": "^0.29.6",
    "pg": "^8.23.1",
    "pino": "^10.4.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.4",
    "@types/pg": "^8.23.1",
    "kysely-codegen": "^0.20.0",
    "node-pg-migrate": "^9.0.0",
    "oxlint": "^1.87.0",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  }
}
