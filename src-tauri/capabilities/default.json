{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Minimal permissions for the main window: the vault commands and opening https links in the system browser",
  "windows": ["main"],
  "permissions": [
    "allow-vault-status",
    "allow-create-vault",
    "allow-unlock-vault",
    "allow-lock-vault",
    "allow-touch-activity",
    "allow-get-settings",
    "allow-save-settings",
    "allow-get-lock-prefs",
    "allow-save-lock-prefs",
    "allow-data-location",
    "allow-wipe-all-data",
    "allow-list-categories",
    "allow-create-category",
    "allow-rename-category",
    "allow-delete-category",
    "allow-list-transactions",
    "allow-create-transaction",
    "allow-update-transaction",
    "allow-delete-transaction",
    "allow-today",
    "allow-set-budget",
    "allow-budget-overview",
    "allow-recover-vault",
    "allow-new-recovery-key",
    "allow-save-recovery-key",
    "allow-budget-history",
    "allow-change-currency",
    "allow-list-recurring",
    "allow-create-recurring",
    "allow-update-recurring",
    "allow-delete-recurring",
    "allow-pay-recurring",
    "allow-skip-recurring",
    "allow-set-recurring-active",
    "allow-end-recurring",
    "allow-recurring-dues",
    "allow-get-notify-due",
    "allow-set-notify-due",
    "allow-show-due-notification",
    "allow-budget-vs-actual",
    "allow-category-trend",
    "allow-year-trend",
    "allow-top-categories",
    "allow-recurring-commitments",
    "allow-recurring-planned-vs-paid",
    "allow-create-backup",
    "allow-restore-backup",
    "allow-restore-backup-new-vault",
    "allow-get-backup-schedule",
    "allow-set-backup-schedule",
    "allow-clear-backup-schedule",
    "allow-export-json",
    "allow-export-csv",
    "allow-export-xlsx",
    "allow-export-pdf",
    "allow-export-preview",
    "allow-get-api-status",
    "allow-set-api-enabled",
    "allow-list-api-tokens",
    "allow-create-api-token",
    "allow-revoke-api-token",
    "allow-app-profile",
    "allow-unlock-attempts",
    "allow-sync-status",
    "allow-sync-start-pairing",
    "allow-sync-enter-code",
    "allow-sync-decide",
    "allow-sync-start",
    "allow-sync-scan",
    "allow-sync-cancel",
    "allow-sync-acknowledge",
    "allow-sync-devices",
    "allow-sync-remove-device",
    "allow-list-documents",
    "allow-get-document",
    "allow-update-document",
    "allow-delete-document",
    "allow-link-document",
    "allow-unlink-document",
    "allow-document-links",
    "allow-document-library-size",
    "allow-document-counts",
    "allow-check-documents",
    "allow-read-document-image",
    "allow-open-document",
    "allow-save-document-copy",
    "allow-document-upload-begin",
    "allow-document-upload-chunk",
    "allow-document-upload-finish",
    "allow-document-upload-cancel",
    "allow-document-add-dropped",
    "core:event:allow-listen",
    "core:event:allow-unlisten",
    {
      "identifier": "opener:allow-open-url",
      "allow": [{ "url": "https://*" }]
    }
  ]
}
