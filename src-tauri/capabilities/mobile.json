{
  "$schema": "../gen/schemas/mobile-schema.json",
  "identifier": "mobile",
  "description": "The camera of the phone, only to read the code the desktop shows",
  "windows": ["main"],
  "platforms": ["android", "iOS"],
  "permissions": [
    "barcode-scanner:allow-scan",
